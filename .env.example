NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use this name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only fallbacks also work for local/server rendering:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional in local dev; if omitted, the app creates a local test mill.
# In production, set this to an active mills.id.
NEXT_PUBLIC_DEFAULT_MILL_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_STRUCTURING_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
SARVAM_API_KEY=
# Optional aliases if your deployment names the key differently:
# SARVAM_AI_API_KEY=
# SARVAM_SUBSCRIPTION_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translate
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
